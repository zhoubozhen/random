function jlab_de {
    Write-Host "[INFO] Starting JupyterLab (devito) on Tesla..."

    # Run remote script
    $raw = ssh bozhen2@tesla.bioen.illinois.edu "bash ~/zbz_start/start_jlab_de.sh"

    # Extract only digits after PORT=
    if ($raw -match "PORT=(\d+)") {
        $port = $matches[1]
    } else {
        Write-Host "❌ ERROR: Failed to extract port. Raw output:" -ForegroundColor Red
        Write-Host $raw
        return
    }

    Write-Host "[INFO] Remote port = $port"

    # Forward port
    Write-Host "[INFO] Forwarding local port $port ..."
    Start-Job { ssh -L "$using:port`:localhost:$using:port" bozhen2@tesla.bioen.illinois.edu -N } | Out-Null
    Start-Sleep -Seconds 2

    Write-Host "[INFO] Opening http://localhost:$port"
    Start-Process "http://localhost:$port"
}
